# Supabase — same project WorkOS uses (ref ijufvisaoafotmpqjleb), reused
# outright for this app after its schema is dropped/rebuilt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — used for blueprint generation, competitor/company search
# grounding, the prospecting agent, Copilot, outreach drafting, and Market
# Insights. Sign up at openrouter.ai and generate an API key. Free-tier
# models are capped at 50 requests/day per account (1000/day once the
# account has $10+ in credits).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Platform transactional email only (welcome, notifications) — NOT used for
# outbound cold-outreach sends, which go through the user's connected inbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Gmail OAuth (send-as-user + reply detection)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/inboxes/gmail/callback

# Encrypts connected-inbox OAuth tokens at rest (32-byte key, base64)
TOKEN_ENCRYPTION_KEY=

# Protects Cloud Scheduler (and other internal job) routes.
# Send as: Authorization: Bearer $CRON_SECRET
# Point Cloud Scheduler at:
#   POST /api/cron/refresh-prospect-index     (daily 03:00)
#   POST /api/cron/scheduled-prospecting      (every 15m)
#   POST /api/cron/market-scan                (every 10m)
#   POST /api/cron/outreach-send-pass         (every 15m)
CRON_SECRET=

# Public origin of this Cloud Run service (used to enqueue background jobs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dodo Payments (subscriptions + credit top-ups). No free plan — 7-day trials only.
# Dashboard: https://app.dodopayments.com — use test keys locally.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/dashboard/campaigns?billing=success
NEXT_PUBLIC_DODO_PAYMENTS_ENVIRONMENT=test_mode

# Dedicated email verifier. Both services share the same random secret.
EMAIL_VERIFIER_URL=https://verifier.example.com
EMAIL_VERIFIER_SECRET=

# Required for prospecting. The deterministic two-step pipeline (find
# companies matching the ICP, then find a decision maker at each one) has no
# other source for either step — AI is not used to run a prospecting search,
# only to draft the company blueprint and the search criteria beforehand.
# Without this key, starting a run fails immediately with a clear error
# rather than silently falling back to anything else. Credits are only spent
# on a successful find, so an unmatched company/person costs nothing.
# Key: https://app.icypeas.com -> Settings -> API
ICYPEAS_API_KEY=

# One-way hashing of deletion/suppression values. Never rotate without a
# migration, or previously suppressed contacts could be collected again.
SUPPRESSION_HASH_SECRET=
PRIVACY_TEAM_EMAIL=privacy@apsurn.com

# Outreach send pass (OpenOutSend-style). Uses connected Gmail inboxes + AI drafts.
# Cron: POST /api/cron/outreach-send-pass every 15m. Manual: POST /api/outreach/send-pass
# Find vs send stay separate — prospecting never auto-emails.
OUTREACH_TIMEZONE=America/New_York
OUTREACH_WINDOW_START_HOUR=8
OUTREACH_WINDOW_END_HOUR=20
OUTREACH_ENFORCE_WORK_HOURS=true
OUTREACH_ENFORCE_WEEKEND_PAUSE=true
OUTREACH_DAILY_CAP=40
OUTREACH_PASS_BATCH=10

# Website crawling (src/lib/scraper/), used when generating a company
# blueprint from a URL and by the nightly canonical-index refresh — NOT by a
# prospecting run, which finds companies and contacts via Icypeas and never
# fetches a page. Requires a headless browser (Chromium). Works on Cloud Run
# using the repo Dockerfile (Playwright base image); on hosts without
# Chromium it degrades to native fetch only. Set SCRAPER_ENABLE_RENDER=0 to
# force fetch-only. Vercel cannot run the browser — deploy the container to
# Cloud Run.
SCRAPER_ENABLE_RENDER=1         # 1 = allow headless-browser escalation, 0 = fetch only
SCRAPER_DOMAIN_DELAY_MS=1500    # politeness delay between hits to the same host

# A prospecting run's own budget: how many companies to attempt from Step 1's
# results before giving up, and the wall-clock ceiling for the whole run.
SCRAPER_MAX_STEPS=40            # max companies attempted per run
SCRAPER_WALLCLOCK_MS=480000     # per-run wall-clock cap (ms), background runs only — interactive runs use a fixed 4 minutes to fit the request
